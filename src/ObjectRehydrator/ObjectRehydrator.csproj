<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>ObjectRehydrator</AssemblyName>
    <RootNamespace>PowerShell.ObjectRehydrator</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>0.2.0</Version>
    <Authors>cn_codegod</Authors>
    <Description>Serialize PowerShell class instances to XML and rehydrate them back into real, typed instances.</Description>

    <!--
      参考 Microsoft.PowerShell.SDK：产出的 DLL 依赖 System.Management.Automation.dll，
      因此必须由 pwsh 进程内 Import-Module 加载（符合需求：做成 DLL 导入 pwsh）。
      只在有 .NET SDK 的机器上 build / publish；本机不装 SDK。
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.4.6">
      <PrivateAssets>none</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
